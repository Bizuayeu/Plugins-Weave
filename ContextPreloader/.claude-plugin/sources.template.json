{
  "_comment": "ContextPreloader v1.0.0 - Copy to ~/.claude/plugins/.contextpreloader/sources.json",
  "version": "1.0.0",
  "settings": {
    "encoding": "utf-8",
    "max_lines_per_file": 0,
    "show_summary": true,
    "url_timeout": 10,
    "mode": "inline"
  },
  "text_extensions": [
    ".txt", ".md", ".json", ".yaml", ".yml", ".csv",
    ".py", ".js", ".ts", ".html", ".css", ".xml",
    ".toml", ".ini", ".cfg", ".log",
    ".sh", ".bash", ".ps1", ".bat"
  ],
  "sources": [
    {
      "_comment": "Example: text file (content loaded directly into context)",
      "id": "project-notes",
      "label": "Project Notes",
      "path": "~/projects/my-app/NOTES.md",
      "type": "auto",
      "enabled": true,
      "description": "Project planning notes and decisions",
      "priority": "high"
    },
    {
      "_comment": "Example: URL (HTML stripped, text extracted into context)",
      "id": "api-docs",
      "label": "API Reference",
      "path": "https://docs.example.com/api/v2",
      "type": "auto",
      "enabled": true,
      "description": "External API documentation",
      "priority": "normal"
    },
    {
      "_comment": "Example: binary file (path listed, use Read tool to view)",
      "id": "design-spec",
      "label": "Design Specification",
      "path": "~/projects/my-app/docs/spec.pdf",
      "type": "auto",
      "enabled": true,
      "description": "System design and architecture spec",
      "priority": "normal"
    }
  ]
}